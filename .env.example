# Copy to .env (git-ignored). Local development values only.
DATABASE_URL=postgres://otterway:local-dev-only@localhost:5432/otterway
S3_ENDPOINT=http://localhost:9000
# Must be reachable from the phone/emulator: Android emulator -> http://10.0.2.2:9000, real device -> LAN IP.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=otterway-videos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-dev-only
S3_SECRET_ACCESS_KEY=local-dev-only-secret
AUTH_MODE=dev
PORT=3000
WORKER_CONCURRENCY=2
# Optional binary overrides
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# YOUTUBE_MODE=embed   (embed = official player only [default]; download = yt-dlp downloads YouTube like other platforms; check YouTube's terms first)
# YOUTUBE_API_KEY=   (optional; YouTube Data API v3, enables view/like/comment counts and duration for YouTube)
# MAX_VIDEO_SECONDS=600
# MAX_VIDEO_BYTES=209715200
# Place detection (off by default). A local LLM server with an OpenAI-compatible API (LM Studio) proposes place names
# from the caption and video frames; OpenStreetMap Nominatim turns names into coordinates (only place names are sent to it, 1 request/second).
# LOCATION_AI=on
# GEOCODER_USER_AGENT=your-app/1.0 (you@example.com)   (required when on; Nominatim policy)
# LLM_URL=http://127.0.0.1:1234                        (LM Studio default)
# LOCATION_TEXT_MODEL=google/gemma-4-12b-qat           (required when on; the model id from GET /v1/models)
# LOCATION_VISION_MODEL=google/gemma-4-12b-qat         (optional; Gemma can read images, empty = skip frame analysis)
# LLM_REASONING_EFFORT=none                            (default none; reasoning models like Gemma 4 otherwise think until the token budget is gone and answer nothing. "omit" = do not send)
# LOCATION_FRAMES=16                                  (most frames per video, 0 to 16, default 16; about one frame per 5 seconds of video, each costs about 5 seconds on a 12B model)
# GEOCODER_URL=https://nominatim.openstreetmap.org
# AI_SUMMARY=on                                        (also writes an AI title and key takeaways; off to disable)
